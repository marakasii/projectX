# Synthetic local demo only. Frontend proxies /api to this backend.
VISAPILOT_DEMO_MODE=true
VISAPILOT_DATA_DIR=local_data
VISAPILOT_ALLOWED_ORIGINS=["http://127.0.0.1:8000", "http://localhost:8000"]
# For a frontend dev proxy, also add its browser origin, e.g. http://localhost:5173.
# For LAN, add the laptop's exact http://address:port. No wildcard or URL path.
# Set true only when serving over HTTPS.
VISAPILOT_COOKIE_SECURE=false
VISAPILOT_SESSION_COOKIE_NAME=visapilot_session
# Optional built frontend, served by the same Uvicorn process. Never point at data_dir.
# Otherwise frontend/dist or the existing static frontend/ is used; without either / opens /docs.
# VISAPILOT_FRONTEND_DIST=frontend/dist
# No AI request at startup; no paid API fallback. Enable only after a separate CLI probe.
VISAPILOT_AI_ENABLED=false
# VISAPILOT_AI_MODEL=<verified CLI model>
